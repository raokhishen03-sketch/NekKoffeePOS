<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nekkoffee.controller.SalesHistoryController"
      spacing="10" style="-fx-background-color: #1e1e24; -fx-padding: 20;">

    <Label text="Sales History" style="-fx-text-fill: #e0a96d; -fx-font-size: 20px;"/>

    <!-- Search and Filter -->
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search by Order ID or Phone"/>
        <DatePicker fx:id="startDate"/>
        <DatePicker fx:id="endDate"/>
        <Button text="Filter" onAction="#filterHistory"/>
    </HBox>

    <!-- Table of Orders -->
    <TableView fx:id="historyTable" prefHeight="400">
        <columns>
            <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="100"/>
            <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
            <TableColumn fx:id="colServiceType" text="Service Type" prefWidth="120"/>
            <TableColumn fx:id="colTotal" text="Total (RM)" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Summary -->
    <HBox spacing="20">
        <Label fx:id="lblTotalSales" text="Total Sales: RM 0.00" style="-fx-text-fill: white;"/>
        <Label fx:id="lblOrderCount" text="Orders: 0" style="-fx-text-fill: white;"/>
    </HBox>
</VBox>
